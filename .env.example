# ReCircuit environment variables — copy to .env for local overrides.
# NEVER commit a real .env with secrets. Render: set these in
# Dashboard → Service → Environment (except RENDER_EXTERNAL_HOSTNAME,
# which Render injects automatically and the app picks up itself).

# --- Production only (set on Render; leave unset for local SQLite dev) ---
# Postgres connection string (Render injects as DATABASE_URL automatically
# when a database is linked; local dev ignores it and uses db.sqlite3).
#DATABASE_URL=postgresql://user:password@host:5432/recircuit

# Required when DEBUG=False. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
#DJANGO_SECRET_KEY=change-me-in-production

# Production hardening switch. Local: leave unset/True. Render: False.
#DJANGO_DEBUG=False

# Extra hosts beyond Render's auto hostname, comma-separated (no scheme).
#DJANGO_ALLOWED_HOSTS=recircuit.onrender.com

# Extra CSRF origins, comma-separated WITH scheme (Render hostname is
# trusted automatically via RENDER_EXTERNAL_HOSTNAME).
#DJANGO_CSRF_TRUSTED_ORIGINS=https://recircuit.onrender.com

# ESP32 firmware: reflash with the production URL before pointing
# hardware at Render (firmware/ holds the LAN default for local dev).
#TELEMETRY_URL=https://recircuit.onrender.com/api/telemetry/
